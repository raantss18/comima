{
  "name": "comima-site",
  "type": "module",
  "version": "1.0.0",
  "description": "Site web du Club Olympiade Mathématiques et Informatique de Madagascar (COMIMa)",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/build-index.mjs",
    "build": "astro build",
    "prebuild": "node scripts/build-index.mjs && node scripts/build-app-packs.mjs && node scripts/fetch-app-apk.mjs && node scripts/build-og.mjs",
    "preview": "astro preview",
    "latex": "node scripts/build-latex.mjs",
    "index": "node scripts/build-index.mjs",
    "og": "node scripts/build-og.mjs",
    "app-packs": "node scripts/build-index.mjs && node scripts/build-app-packs.mjs",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^7.4.2",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "octokit": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  }
