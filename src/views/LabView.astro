---
import Base from '../layouts/Base.astro';
import KatexInit from '../components/KatexInit.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { cours } from '../lib/data';
import { labChapters } from '../lib/labs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const fr = lang === 'fr';

const currentPath = localePath(lang, 'lab');
const altPath = localePath(fr ? 'en' : 'fr', 'lab');
const chapters = cours.filter((c) => labChapters.includes(c.id)).sort((a, b) => a.numero - b.numero);

const intro = fr
  ? 'Un problème par chapitre du cours, transformé en expérience : manipule, collecte des données dans ton journal d’essais, formule une conjecture… puis demande un indice ou la généralisation. Comme un chercheur, on observe d’abord, on prouve ensuite.'
  : 'One problem per course chapter, turned into an experiment: manipulate, collect data in your trial log, state a conjecture… then ask for a hint or the generalisation. Like a researcher: observe first, prove afterwards.';
const method = fr
  ? ['Manipule', 'Note des cas', 'Conjecture', 'Teste', 'Généralise']
  : ['Manipulate', 'Record cases', 'Conjecture', 'Test', 'Generalise'];
---

<Base lang={lang} title={fr ? 'Laboratoire de conjectures' : 'Conjecture lab'} description={intro} currentPath={currentPath} altPath={altPath}>
  <div class="container">
    <div class="page-head">
      <h1>{fr ? '🧪 Laboratoire de conjectures' : '🧪 Conjecture lab'}</h1>
      <p>{intro}</p>
      <ol class="lab-method">
        {method.map((m) => <li>{m}</li>)}
      </ol>
      <nav class="group-nav" aria-label={fr ? 'Chapitres' : 'Chapters'}>
        {
          chapters.map((c) => (
            <a class="badge badge-theme" href={`#${c.id}`}>
              {c.numero} · {(fr ? c.titre_fr : c.titre_en).replace(/^(Chapitre|Chapter) \d+ — /, '')}
            </a>
          ))
        }
      </nav>
    </div>

    {
      chapters.map((c) => (
        <section class="lab-section" id={c.id}>
          <div class="lab-host" data-lab={c.id} data-lang={lang}>
            <p class="muted">{fr ? 'Chargement du laboratoire…' : 'Loading the lab…'}</p>
          </div>
        </section>
      ))
    }

    <ShareButtons lang={lang} title={fr ? 'Laboratoire de conjectures' : 'Conjecture lab'} />
  </div>

  <KatexInit />
  <script>
    import { initLabs } from '../scripts/lab';
    const lang = document.documentElement.lang === 'en' ? 'en' : 'fr';
    initLabs(lang);
  </script>
</Base>
