---
import Base from '../layouts/Base.astro';
import Marks from '../components/Marks.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import ShareButtons from '../components/ShareButtons.astro';
import { withBase } from '../lib/site';
import { cours } from '../lib/data';
import { sims } from '../lib/sims';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const sorted = [...cours].sort((a, b) => a.numero - b.numero);
const currentPath = localePath(lang, 'courses');
const altPath = localePath(lang === 'fr' ? 'en' : 'fr', 'courses');

const labLabel = lang === 'fr' ? '🧪 Simulations' : '🧪 Simulations';
const labBase = withBase(localePath(lang, 'simulations'));
---

<Base
  lang={lang}
  title={t('courses.title')}
  description={t('courses.intro')}
  currentPath={currentPath}
  altPath={altPath}
>
  <div class="container">
    <div class="page-head">
      <h1>{t('courses.title')}</h1>
      <p>{t('courses.intro')}</p>
      <a
        class="btn btn-primary"
        href={withBase('recueil-techniques-resolution-problemes.pdf')}
        download
      >
        📘 {t('courses.booklet')}
      </a>
      <a class="btn btn-outline" href={labBase}>{labLabel} →</a>
    </div>

    <div class="cards">
      {
        sorted.map((c) => (
          <div class="card" id={c.id} data-mark-item={`cours:${c.id}`}>
            <div class="badges">
              {c.tags.map((tag) => (
                <span class="badge badge-theme">{tag}</span>
              ))}
            </div>
            <h3>
              <a href={withBase(localePath(lang, 'courses', `${c.id}/`))}>{lang === 'fr' ? c.titre_fr : c.titre_en}</a>
            </h3>
            <p class="muted small">
              {c.sourceLabel}
              {c.pages ? ` · ${c.pages} ${t('courses.pages')}` : ''}
            </p>
            <p class="muted">{lang === 'fr' ? c.description_fr : c.description_en}</p>
            <div class="btn-row" style="margin-top: 0.4rem;">
              <a class="btn btn-outline btn-sm" href={withBase(c.pdf)} download>
                {t('courses.download')}
              </a>
              {c.tex && (
                <a class="btn btn-outline btn-sm" href={withBase(c.tex)} download>
                  {t('courses.tex')}
                </a>
              )}
              {c.texZip && (
                <a class="btn btn-outline btn-sm" href={withBase(c.texZip)} download>
                  {t('courses.texzip')}
                </a>
              )}
            </div>
            <ShareButtons
              lang={lang}
              compact
              title={lang === 'fr' ? c.titre_fr : c.titre_en}
              url={new URL(withBase(localePath(lang, 'courses', `${c.id}/`)), Astro.site).href}
            />
            {sims.some((s) => s.chapter === c.id) && (
              <p style="margin: 0.7rem 0 0;">
                <a class="btn btn-primary btn-sm" href={`${labBase}#${c.id}`}>
                  {labLabel} ({sims.filter((s) => s.chapter === c.id).length})
                </a>
              </p>
            )}
          </div>
        ))
      }
    </div>
    <p class="muted small" style="margin-top: 1.5rem;">{t('exo.pdf.missing')}</p>
    <ShareButtons lang={lang} title={t('courses.title')} />
  </div>

  <Marks />
</Base>
