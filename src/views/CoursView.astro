---
import Base from '../layouts/Base.astro';
import Marks from '../components/Marks.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import ShareButtons from '../components/ShareButtons.astro';
import { withBase } from '../lib/site';
import { cours } from '../lib/data';
import { sims } from '../lib/sims';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const sorted = [...cours].sort((a, b) => a.numero - b.numero);
const currentPath = localePath(lang, 'courses');
const altPath = localePath(lang === 'fr' ? 'en' : 'fr', 'courses');

const labLabel = lang === 'fr' ? '🧪 Simulations' : '🧪 Simulations';
const labBase = withBase(localePath(lang, 'simulations'));
---

<Base
  lang={lang}
  title={t('courses.title')}
  description={t('courses.intro')}
  currentPath={currentPath}
  altPath={altPath}
>
  <div class="container">
    <div class="page-head">
      <h1>{t('courses.title')}</h1>
      <p>{t('courses.intro')}</p>
      <a
        class="btn btn-primary"
        href={withBase('recueil-techniques-resolution-problemes.pdf')}
        download
      >
        📘 {t('courses.booklet')}
      </a>
      <a class="btn btn-outline" href={labBase}>{labLabel} →</a>
    </div>

    <div class="course-grid">
      {
        sorted.map((c) => {
          const nsims = sims.filter((s) => s.chapter === c.id).length;
          const title = lang === 'fr' ? c.titre_fr : c.titre_en;
          const href = withBase(localePath(lang, 'courses', `${c.id}/`));
          return (
            <article class="course-card" id={c.id} data-mark-item={`cours:${c.id}`} style={`--hue: ${(c.numero * 47) % 360}`}>
              <a class="course-head" href={href} tabindex="-1" aria-hidden="true">
                <span class="course-num">{String(c.numero).padStart(2, '0')}</span>
                <span class="course-tags">{c.tags.slice(0, 2).map((tag) => <span class="badge badge-theme">{tag}</span>)}</span>
              </a>
              <div class="course-body">
                <h3><a href={href}>{title}</a></h3>
                <p class="muted small">{c.sourceLabel}{c.pages ? ` · ${c.pages} ${t('courses.pages')}` : ''}</p>
                <p class="course-desc">{lang === 'fr' ? c.description_fr : c.description_en}</p>
                <div class="btn-row">
                  <a class="btn btn-primary btn-sm" href={href}>{lang === 'fr' ? 'Ouvrir' : 'Open'}</a>
                  <a class="btn btn-outline btn-sm" href={withBase(c.pdf)} download>PDF</a>
                  {nsims > 0 && <a class="btn btn-outline btn-sm" href={`${labBase}#${c.id}`}>🧪 {nsims}</a>}
                </div>
                <details class="course-more">
                  <summary>{lang === 'fr' ? 'Partager, sources' : 'Share, sources'}</summary>
                  {c.texZip && <p><a class="btn btn-outline btn-sm" href={withBase(c.texZip)} download>{t('courses.texzip')}</a></p>}
                  <ShareButtons lang={lang} compact title={title} url={new URL(href, Astro.site).href} />
                </details>
              </div>
            </article>
          );
        })
      }
    </div>
    <p class="muted small" style="margin-top: 1.5rem;">{t('exo.pdf.missing')}</p>
    <ShareButtons lang={lang} title={t('courses.title')} />
  </div>

  <Marks />
</Base>
