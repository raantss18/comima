---
import Base from '../layouts/Base.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { withBase } from '../lib/site';
import { appRelease, mo, releasesUrl } from '../lib/app-release';
import { qrSvg } from '../lib/qr';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const fr = lang === 'fr';
const currentPath = localePath(lang, 'app');
const altPath = localePath(fr ? 'en' : 'fr', 'app');

const rel = appRelease();
const qr = await qrSvg(new URL(withBase('app/'), Astro.site).href);
const label: Record<string, { fr: string; en: string; hint: { fr: string; en: string } }> = {
  'arm64-v8a': { fr: 'Téléphones récents', en: 'Recent phones', hint: { fr: 'le plus courant', en: 'most common' } },
  'armeabi-v7a': { fr: 'Téléphones anciens', en: 'Older phones', hint: { fr: 'système 32 bits', en: '32-bit system' } },
  universal: { fr: 'Je ne sais pas', en: 'I don’t know', hint: { fr: 'fonctionne partout, plus lourd', en: 'works everywhere, larger' } },
};
const description = fr
  ? 'L’application Android de COMIMa : entraînement hors ligne, toutes les notions du cours, exercices, statistiques, rappels. Gratuite.'
  : 'COMIMa’s Android app: offline practice, every topic of the course, exercises, statistics, reminders. Free.';
---

<Base lang={lang} title={t('nav.app')} description={description} currentPath={currentPath} altPath={altPath}>
  <div class="container">
    <div class="page-head">
      <h1>📱 {fr ? 'L’application COMIMa' : 'The COMIMa app'}</h1>
      <p>{description}</p>
    </div>

    {
      rel ? (
        <section class="card app-download">
          <h2>
            {fr ? 'Télécharger l’application' : 'Download the app'}
          </h2>
          <p>
            <a class="btn btn-primary btn-lg" href={rel.downloads.find((d) => d.abi === 'universal')?.url} data-apk-auto>
              ⬇ {fr ? 'Télécharger pour Android' : 'Download for Android'} · <span data-apk-size>{mo(rel.downloads.find((d) => d.abi === 'universal')?.bytes ?? 0, fr)}</span>
            </a>
          </p>
          <p class="muted small">
            {fr
              ? 'Le fichier adapté à votre téléphone est choisi automatiquement. Si l’installation échoue, prenez un autre fichier ci-dessous.'
              : 'The file matching your phone is picked automatically. If the install fails, take another file below.'}
          </p>
          <figure class="app-qr">
            <div class="qr" role="img" aria-label={fr ? 'QR code vers cette page' : 'QR code to this page'} set:html={qr} />
            <figcaption>{fr ? 'Pour télécharger depuis un autre écran, scanne ce code.' : 'To download from another screen, scan this code.'}</figcaption>
          </figure>
          <ul class="app-files">
            {rel.downloads.map((d) => (
              <li>
                <a href={d.url} data-apk={d.abi} data-size={mo(d.bytes, fr)} rel="noopener">
                  <strong>{label[d.abi][lang]}</strong> <span class="muted small">— {label[d.abi].hint[lang]} · {mo(d.bytes, fr)}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="muted small">
            Android 7 {fr ? 'ou plus récent' : 'or later'} ·{' '}
            {fr ? 'les mises à jour s’installent ensuite depuis l’application.' : 'updates are then installed from within the app.'}
          </p>
          <details>
            <summary>{fr ? 'Installer pas à pas' : 'Step-by-step install'}</summary>
            <ol>
              {fr ? (
                <>
                  <li>Télécharger le fichier, puis l’ouvrir (notification ou dossier « Téléchargements »).</li>
                  <li>Android demande d’autoriser l’installation depuis le navigateur : accepter pour cette fois.</li>
                  <li>Installer, puis ouvrir COMIMa : tout fonctionne sans connexion.</li>
                </>
              ) : (
                <>
                  <li>Download the file, then open it (notification or “Downloads” folder).</li>
                  <li>Android asks to allow installs from the browser: accept for this time.</li>
                  <li>Install, then open COMIMa: everything works offline.</li>
                </>
              )}
            </ol>
            <p class="muted small">
              {fr ? 'Empreintes SHA-256 (vérification) :' : 'SHA-256 fingerprints (verification):'}
              {rel.downloads.map((d) => (
                <code class="app-hash">
                  {d.abi} {d.sha256}
                </code>
              ))}
            </p>
          </details>
        </section>
      ) : (
        <p class="muted">{fr ? 'Première version bientôt disponible.' : 'First version coming soon.'}</p>
      )
    }

    <section class="sim-cards app-features">
      {(fr
        ? [
            ['🎯', 'Toutes les notions du cours', 'Quiz corrigés à l’instant : nombres, expressions (toute forme équivalente acceptée), ensembles, intervalles, preuves à remettre dans l’ordre.'],
            ['📚', 'Le site dans la poche', 'Exercices, cours, sujets, actualités : consultables sans connexion.'],
            ['📈', 'Statistiques', 'Réussite par thème et par notion, séries de jours, temps de travail.'],
            ['🔔', 'Rappels discrets', 'Au plus un par jour, à l’heure choisie, jamais si l’on s’est déjà entraîné ; pause examens.'],
            ['👥', 'Téléphones partagés', 'Plusieurs profils sur un même téléphone.'],
            ['🔒', 'Mises à jour vérifiées', 'Contenus et application signés : même en sautant des versions, la mise à jour est sûre.'],
          ]
        : [
            ['🎯', 'Every topic of the course', 'Instantly graded quizzes: numbers, expressions (any equivalent form accepted), sets, intervals, proofs to put in order.'],
            ['📚', 'The website in your pocket', 'Exercises, courses, papers, news: available offline.'],
            ['📈', 'Statistics', 'Success by theme and topic, streaks, practice time.'],
            ['🔔', 'Gentle reminders', 'At most one a day, at a chosen time, never if you already practised; exam break.'],
            ['👥', 'Shared phones', 'Several profiles on one phone.'],
            ['🔒', 'Verified updates', 'Signed content and app: safe to update even after skipping versions.'],
          ]
      ).map(([icon, title, text]) => (
        <div class="sim-card">
          <span class="sim-card-icon" aria-hidden="true">{icon}</span>
          <h3>{title}</h3>
          <p class="muted">{text}</p>
        </div>
      ))}
    </section>

    <p>
      <a class="btn btn-outline" href={withBase(localePath(lang, 'training'))}>🎯 {fr ? 'S’entraîner sur le site' : 'Practise on the website'}</a>
    </p>

    <p class="muted small">
      {fr ? 'Nouveautés de chaque version et fichiers d’installation : ' : 'What’s new in each version, and installation files: '}
      <a href={releasesUrl} rel="noopener">{fr ? 'page de la dernière version sur GitHub' : 'latest release page on GitHub'}</a>.
    </p>

    <ShareButtons lang={lang} title={fr ? 'Application COMIMa' : 'COMIMa app'} />
  </div>
  <script>
    import { initAppDownload } from '../scripts/app-download';
    initAppDownload();
  </script>
</Base>
