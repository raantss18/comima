---
import Base from '../layouts/Base.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { withBase } from '../lib/site';
import { centres } from '../lib/centres';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const currentPath = localePath(lang, 'about');
const altPath = localePath(lang === 'fr' ? 'en' : 'fr', 'about');

const contentFr = {
  missionTitle: 'Notre mission',
  mission: [
    'COMIMa — le Club Olympiade Mathématiques et Informatique de Madagascar — prépare les collégiens et lycéens Malagasy aux compétitions de mathématiques et d’informatique : olympiades nationales, panafricaines (PAMO) et internationales (IMO, IOI).',
    'COMIMa est une association nationale, présente dans cinq centres : Antananarivo, Antsiranana, Ambositra, Ambatondrazaka et Fianarantsoa. Les séances sont gratuites et ouvertes à toutes les élèves et tous les élèves motivés, quel que soit leur établissement.',
    'Au-delà des compétitions, notre objectif est de faire découvrir le plaisir de la recherche mathématique : chercher longtemps, se tromper, recommencer, et savourer une belle solution.',
  ],
  centresTitle: 'Nos centres',
  centresIntro:
    'Les regroupements de l’année 2026-2027 se déploient centre après centre. Voici où le club est présent :',
  readMore: 'Lire l’actualité →',
  partnersTitle: 'Nos partenaires',
  partnersText:
    'COMIMa est le cœur d’un réseau : Animath et Campus France nous soutiennent, Fianarako nous appuie, l’AEMIA aide nos encadrants, et des associations locales indépendantes comme MahKinga (Antsiranana) et iMatematiko (Fianarantsoa) font vivre les centres.',
  partnersCta: 'Découvrir nos partenaires et associations →',
  teamTitle: 'L’équipe',
  team: 'L’équipe d’encadrement est constituée d’enseignants et d’anciens élèves passionnés, bénévoles dans chaque centre. Le bureau national et les encadrants sont présentés sur la page Contact.',
};

const contentEn = {
  missionTitle: 'Our mission',
  mission: [
    'COMIMa — the Mathematics and Computer Science Olympiad Club of Madagascar — prepares Malagasy middle and high school students for mathematics and computer science competitions: national olympiads, Pan-African (PAMO) and international ones (IMO, IOI).',
    'COMIMa is a national association, present in five centres: Antananarivo, Antsiranana, Ambositra, Ambatondrazaka and Fianarantsoa. Sessions are free and open to all motivated students, whatever their school.',
    'Beyond competitions, our goal is to share the joy of mathematical research: searching for a long time, failing, trying again, and savouring a beautiful solution.',
  ],
  centresTitle: 'Our centres',
  centresIntro:
    'The 2026-2027 group sessions are rolling out centre by centre. Here is where the club is present:',
  readMore: 'Read the story →',
  partnersTitle: 'Our partners',
  partnersText:
    'COMIMa is the heart of a network: Animath and Campus France support us, Fianarako backs us, AEMIA helps our coaches, and independent local associations such as MahKinga (Antsiranana) and iMatematiko (Fianarantsoa) bring the centres to life.',
  partnersCta: 'Discover our partners and associations →',
  teamTitle: 'The team',
  team: 'The supervising team is made up of passionate teachers and alumni, volunteering in each centre. The national board and the coaches are listed on the Contact page.',
};

const c = lang === 'fr' ? contentFr : contentEn;
---

<Base lang={lang} title={t('about.title')} currentPath={currentPath} altPath={altPath}>
  <div class="container">
    <div class="page-head">
      <h1>{t('about.title')}</h1>
    </div>
    <div class="prose">
      <h2>{c.missionTitle}</h2>
      {c.mission.map((p) => <p>{p}</p>)}

      <h2>{c.centresTitle}</h2>
      <p>{c.centresIntro}</p>
      <ul>
        {
          centres.map((ct) => (
            <li>
              <strong>{ct.name}</strong>
              {(lang === 'fr' ? ct.note_fr : ct.note_en) && <> — {lang === 'fr' ? ct.note_fr : ct.note_en}</>}
              {ct.article && (
                <>
                  {' '}
                  <a href={withBase(localePath(lang, 'news', `${ct.article}/`))}>{c.readMore}</a>
                </>
              )}
            </li>
          ))
        }
      </ul>

      <h2>{c.partnersTitle}</h2>
      <p>{c.partnersText}</p>
      <p>
        <a class="btn btn-primary btn-sm" href={withBase(localePath(lang, 'partners'))}>{c.partnersCta}</a>
      </p>

      <h2>{c.teamTitle}</h2>
      <p>{c.team}</p>
      <p>
        <a href={withBase(localePath(lang, 'contact'))}>{t('nav.contact')} →</a>
      </p>
    </div>
  </div>
</Base>
