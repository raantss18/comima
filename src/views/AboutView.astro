---
import Base from '../layouts/Base.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { withBase } from '../lib/site';
import { partnerUrl } from '../lib/partners';
import { centres } from '../lib/centres';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const currentPath = localePath(lang, 'about');
const altPath = localePath(lang === 'fr' ? 'en' : 'fr', 'about');

const contentFr = {
  missionTitle: 'Notre mission',
  mission: [
    'COMIMa — le Club Olympiade Mathématiques et Informatique de Madagascar — prépare les collégiens et lycéens Malagasy aux compétitions de mathématiques et d’informatique : olympiades nationales, panafricaines (PAMO) et internationales (IMO, IOI).',
    'COMIMa est une association nationale, présente dans cinq centres : Antananarivo, Antsiranana, Ambositra, Ambatondrazaka et Fianarantsoa. Les séances sont gratuites et ouvertes à toutes les élèves et tous les élèves motivés, quel que soit leur établissement.',
    'Au-delà des compétitions, notre objectif est de faire découvrir le plaisir de la recherche mathématique : chercher longtemps, se tromper, recommencer, et savourer une belle solution.',
  ],
  centresTitle: 'Nos centres',
  centresIntro:
    'Les regroupements de l’année 2026-2027 se déploient centre après centre. Voici où le club est présent :',
  readMore: 'Lire l’actualité →',
  partnersTitle: 'Nos partenaires',
  animath:
    'COMIMa travaille en partenariat avec Animath, association française qui promeut les mathématiques auprès des jeunes et accompagne les clubs olympiques dans le monde francophone. Ce partenariat donne accès à des ressources pédagogiques éprouvées (polycopiés, stages, annales) et à un réseau international de clubs.',
  aemia:
    'COMIMa collabore aussi avec l’AEMIA, l’Association des Étudiants en Mathématiques et Informatique d’Antananarivo. L’AEMIA nous accompagne dans l’animation des séances et des regroupements à Antananarivo, en particulier sur le volet communication.',
  fianarako:
    'COMIMa compte aussi parmi ses partenaires Fianarako, plateforme de partage et lieu de soutien à des enseignants créateurs, qui promeut et accompagne les enseignants malagasy grâce à l’e-learning. Fianarako soutient notre projet aux côtés d’Animath.',
  campusFrance:
    'Campus France, l’agence française pour la promotion de l’enseignement supérieur et l’accueil des étudiants internationaux, est également partenaire de COMIMa.',
  mahkinga:
    'À Antsiranana, COMIMa travaille avec le Club de Maths-Info Mahkinga, sa filiale indépendante : le club anime le centre d’Antsiranana, à l’origine des premiers regroupements de l’année 2026-2027.',
  imatematiko:
    'À Fianarantsoa, COMIMa est en partenariat avec iMatematiko, le club de mathématiques de l’École Normale Supérieure de Fianarantsoa, qui accompagne le centre de Fianarantsoa.',
  teamTitle: 'L’équipe',
  team: 'L’équipe d’encadrement est constituée d’enseignants et d’anciens élèves passionnés, bénévoles dans chaque centre. Le bureau national et les encadrants sont présentés sur la page Contact.',
};

const contentEn = {
  missionTitle: 'Our mission',
  mission: [
    'COMIMa — the Mathematics and Computer Science Olympiad Club of Madagascar — prepares Malagasy middle and high school students for mathematics and computer science competitions: national olympiads, Pan-African (PAMO) and international ones (IMO, IOI).',
    'COMIMa is a national association, present in five centres: Antananarivo, Antsiranana, Ambositra, Ambatondrazaka and Fianarantsoa. Sessions are free and open to all motivated students, whatever their school.',
    'Beyond competitions, our goal is to share the joy of mathematical research: searching for a long time, failing, trying again, and savouring a beautiful solution.',
  ],
  centresTitle: 'Our centres',
  centresIntro:
    'The 2026-2027 group sessions are rolling out centre by centre. Here is where the club is present:',
  readMore: 'Read the story →',
  partnersTitle: 'Our partners',
  animath:
    'COMIMa works in partnership with Animath, the French association that promotes mathematics among young people and supports olympiad clubs across the French-speaking world. This partnership provides proven teaching resources (booklets, camps, past papers) and an international network of clubs.',
  aemia:
    'COMIMa also works with AEMIA, the Association of Mathematics and Computer Science Students of Antananarivo. AEMIA supports us in running the sessions and gatherings in Antananarivo, especially on the communication side.',
  fianarako:
    'COMIMa also counts Fianarako among its partners: a sharing platform and a place of support for teacher-creators, which promotes and supports Malagasy educators through e-learning. Fianarako backs our project alongside Animath.',
  campusFrance:
    'Campus France, the French agency for the promotion of higher education and the reception of international students, is also a partner of COMIMa.',
  mahkinga:
    'In Antsiranana, COMIMa works with the Mahkinga Maths-CS Club, its independent affiliate: the club runs the Antsiranana centre, which launched this year’s first group sessions (2026-2027).',
  imatematiko:
    'In Fianarantsoa, COMIMa partners with iMatematiko, the mathematics club of the École Normale Supérieure de Fianarantsoa, which supports the Fianarantsoa centre.',
  teamTitle: 'The team',
  team: 'The supervising team is made up of passionate teachers and alumni, volunteering in each centre. The national board and the coaches are listed on the Contact page.',
};

const c = lang === 'fr' ? contentFr : contentEn;
---

<Base lang={lang} title={t('about.title')} currentPath={currentPath} altPath={altPath}>
  <div class="container">
    <div class="page-head">
      <h1>{t('about.title')}</h1>
    </div>
    <div class="prose">
      <h2>{c.missionTitle}</h2>
      {c.mission.map((p) => <p>{p}</p>)}

      <h2>{c.centresTitle}</h2>
      <p>{c.centresIntro}</p>
      <ul>
        {
          centres.map((ct) => (
            <li>
              <strong>{ct.name}</strong>
              {(lang === 'fr' ? ct.note_fr : ct.note_en) && <> — {lang === 'fr' ? ct.note_fr : ct.note_en}</>}
              {ct.article && (
                <>
                  {' '}
                  <a href={withBase(localePath(lang, 'news', `${ct.article}/`))}>{c.readMore}</a>
                </>
              )}
            </li>
          ))
        }
      </ul>

      <h2>{c.partnersTitle}</h2>
      <p>{c.animath}</p>
      <p>
        <a class="btn btn-outline btn-sm" href={partnerUrl('animath')} rel="noopener">
          animath.fr →
        </a>
      </p>
      <p>{c.aemia}</p>
      <p>
        <a
          class="btn btn-outline btn-sm"
          href={partnerUrl('aemia')}
          rel="noopener"
        >
          {lang === 'fr' ? 'Page Facebook de l’AEMIA →' : 'AEMIA Facebook page →'}
        </a>
      </p>

      <p>{c.fianarako}</p>
      <p>
        <a
          class="btn btn-outline btn-sm"
          href={partnerUrl('fianarako')}
          rel="noopener noreferrer"
        >
          {lang === 'fr' ? 'Page Facebook de Fianarako →' : 'Fianarako Facebook page →'}
        </a>
      </p>
      <p>{c.campusFrance}</p>
      <p>
        <a class="btn btn-outline btn-sm" href={partnerUrl('campus-france')} rel="noopener noreferrer">
          campusfrance.org →
        </a>
      </p>

      <p>{c.mahkinga}</p>
      <p>
        <a class="btn btn-outline btn-sm" href={partnerUrl('mahkinga')} rel="noopener noreferrer">
          {lang === 'fr' ? 'Page Facebook de Mahkinga →' : 'Mahkinga Facebook page →'}
        </a>
      </p>
      <p>{c.imatematiko}</p>
      <p>
        <a class="btn btn-outline btn-sm" href={partnerUrl('imatematiko')} rel="noopener noreferrer">
          {lang === 'fr' ? 'Page Facebook d’iMatematiko →' : 'iMatematiko Facebook page →'}
        </a>
      </p>

      <h2>{c.teamTitle}</h2>
      <p>{c.team}</p>
      <p>
        <a href={withBase(localePath(lang, 'contact'))}>{t('nav.contact')} →</a>
      </p>
    </div>
  </div>
</Base>
