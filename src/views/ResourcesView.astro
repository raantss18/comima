---
import Base from '../layouts/Base.astro';
import ExoCard from '../components/ExoCard.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { exercices, themes } from '../lib/data';
import { paliers, progression } from '../lib/progression';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const solved = exercices.filter((e) => e.a_solution).length;
const inProg = exercices.filter((e) => e.progression).length;

const currentPath = localePath(lang, 'resources');
const altPath = localePath(lang === 'fr' ? 'en' : 'fr', 'resources');
---

<Base
  lang={lang}
  title={t('resources.title')}
  description={t('resources.intro')}
  currentPath={currentPath}
  altPath={altPath}
>
  <div class="container">
    <div class="page-head">
      <h1>{t('resources.title')}</h1>
      <p>{t('resources.intro')}</p>
    </div>

    <p class="stat-line">
      <strong>{exercices.length}</strong> {lang === 'fr' ? 'exercices et problèmes' : 'exercises and problems'} ·
      <strong>{solved}</strong> {lang === 'fr' ? 'avec solution' : 'with a solution'} ·
      <strong>{inProg}</strong> {lang === 'fr' ? 'dans la progression de l\'année' : 'in the year\'s progression'}
    </p>

    <section class="prog" aria-labelledby="prog-title">
      <h2 id="prog-title" class="h-small">{lang === 'fr' ? 'Progression de l\'année' : 'This year\'s progression'}</h2>
      <p class="muted small">
        {lang === 'fr'
          ? 'D\'après A. Engel, Problem-Solving Strategies. Choisissez une étape pour voir ses problèmes, du plus accessible au plus difficile.'
          : 'After A. Engel, Problem-Solving Strategies. Pick a step to see its problems, from the most accessible to the hardest.'}
      </p>
      <div class="prog-chips" role="group">
        {progression.map((p) => (
          <button type="button" class="prog-chip" data-prog={p.n} aria-pressed="false">
            <span class="prog-n">{p.n}</span>
            <span>{p[lang]}{p.engel ? <span class="muted small"> · {p.engel}</span> : null}</span>
            <span class="prog-count">{exercices.filter((e) => e.progression === p.n).length}</span>
          </button>
        ))}
      </div>
    </section>

    <form class="filters" id="exo-filters" aria-label={t('gen.filters')}>
      <div class="field" style="margin: 0;">
        <label for="f-search">{t('resources.search')}</label>
        <input type="search" id="f-search" name="search" autocomplete="off" />
      </div>
      <div class="field" style="margin: 0;">
        <label for="f-theme">{t('resources.theme')}</label>
        <select id="f-theme" name="theme">
          <option value="">{t('resources.all')}</option>
          {themes.map((th) => <option value={th}>{th}</option>)}
        </select>
      </div>
      <div class="field" style="margin: 0;">
        <label for="f-palier">{t('resources.level')}</label>
        <select id="f-palier" name="palier">
          <option value="">{t('resources.all')}</option>
          {Object.entries(paliers).map(([n, l]) => <option value={n}>{l[lang]}</option>)}
        </select>
      </div>
      <div class="field" style="margin: 0;">
        <label for="f-diff">{t('resources.difficulty')}</label>
        <select id="f-diff" name="difficulte">
          <option value="">{t('resources.all')}</option>
          {[1, 2, 3, 4, 5].map((d) => (
            <option value={String(d)}>{'★'.repeat(d)} — {t(`difficulty.${d}` as 'difficulty.1')}</option>
          ))}
        </select>
      </div>
      <input type="hidden" name="progression" id="f-prog" value="" />
    </form>

    <p class="muted small" style="margin: 0 0 1rem;">
      <span id="exo-count">{exercices.length}</span> {t('resources.count')}
    </p>

    {
      Object.entries(paliers).map(([n, l]) => (
        <section class="palier" data-palier={n}>
          <h2 class="palier-head">{l[lang]}</h2>
          <div class="cards">
            {exercices.filter((e) => e.palier === Number(n)).map((exo) => <ExoCard exo={exo} lang={lang} />)}
          </div>
        </section>
      ))
    }
    <p class="muted" id="exo-empty" hidden>{t('resources.empty')}</p>
    <div class="btn-row" style="justify-content: center;">
      <button type="button" class="btn btn-outline" id="exo-more">{lang === 'fr' ? 'Afficher plus' : 'Show more'}</button>
    </div>
  </div>

  <script>
    const STEP = 24;
    const form = document.getElementById('exo-filters') as HTMLFormElement;
    const sections = [...document.querySelectorAll<HTMLElement>('section.palier')];
    const cards = [...document.querySelectorAll<HTMLElement>('section.palier .exo-card')];
    const count = document.getElementById('exo-count')!;
    const empty = document.getElementById('exo-empty')!;
    const more = document.getElementById('exo-more') as HTMLButtonElement;
    const prog = document.getElementById('f-prog') as HTMLInputElement;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.prog-chip')];
    let limit = STEP;

    // Lien direct vers une étape ou un palier : ?progression=3, ?palier=2
    const qs = new URLSearchParams(location.search);
    if (qs.get('progression')) prog.value = qs.get('progression')!;
    if (qs.get('palier')) (form.elements.namedItem('palier') as HTMLSelectElement).value = qs.get('palier')!;

    function criteria() {
      const data = new FormData(form);
      return {
        search: String(data.get('search') ?? '').toLowerCase().trim(),
        theme: String(data.get('theme') ?? ''),
        palier: String(data.get('palier') ?? ''),
        diff: String(data.get('difficulte') ?? ''),
        prog: String(data.get('progression') ?? ''),
      };
    }
    function matches(card: HTMLElement, c: ReturnType<typeof criteria>) {
      return (
        (!c.search || (card.dataset.search ?? '').includes(c.search)) &&
        (!c.theme || (card.dataset.themeList ?? '').split(',').includes(c.theme)) &&
        (!c.palier || card.dataset.palier === c.palier) &&
        (!c.diff || card.dataset.difficulte === c.diff) &&
        (!c.prog || card.dataset.progression === c.prog)
      );
    }

    function apply() {
      const c = criteria();
      let total = 0;
      let shown = 0;
      for (const card of cards) {
        const ok = matches(card, c);
        if (ok) total++;
        const show = ok && shown < limit;
        if (show) shown++;
        card.hidden = !show;
      }
      for (const s of sections) s.hidden = !s.querySelector('.exo-card:not([hidden])');
      for (const ch of chips) ch.setAttribute('aria-pressed', String(ch.dataset.prog === c.prog));
      count.textContent = String(total);
      empty.hidden = total > 0;
      more.hidden = shown >= total;
    }

    for (const ch of chips)
      ch.addEventListener('click', () => {
        prog.value = prog.value === ch.dataset.prog ? '' : ch.dataset.prog!;
        limit = STEP;
        apply();
      });
    more.addEventListener('click', () => {
      limit += STEP;
      apply();
    });
    form.addEventListener('input', () => {
      limit = STEP;
      apply();
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    apply();
  </script>
</Base>
