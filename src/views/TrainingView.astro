---
import Base from '../layouts/Base.astro';
import KatexInit from '../components/KatexInit.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { withBase } from '../lib/site';
import { cours } from '../lib/data';
import { ogPath } from '../lib/og';
import { sims } from '../lib/sims';
import { notionById, hasFicheFigure, md, clientQuestions, themeLabel, type Notion } from '../lib/training';
import AccountPanel from '../components/AccountPanel.astro';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const t = useT(lang);
const fr = lang === 'fr';
const n = notionById(id) as Notion;
const currentPath = localePath(lang, 'training', `${id}/`);
const altPath = localePath(fr ? 'en' : 'fr', 'training', `${id}/`);
const chapter = cours.find((c) => c.id === n.chapitre);
const relatedSims = sims.filter((s) => s.chapter === n.chapitre);
const data = { notion: n.id, theme: n.theme, lang, questions: clientQuestions(n, lang), engine: withBase('app/engine.wasm') };
const description = `${themeLabel[n.theme]?.[lang] ?? n.theme} · ${n.questions.length} questions`;
---

<Base lang={lang} title={n.titre[lang]} description={description} currentPath={currentPath} altPath={altPath} image={ogPath('notion', n.id, lang)}>
  <KatexInit />
  <div class="container">
    <nav class="breadcrumb" aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}>
      <a href={withBase(localePath(lang, 'training'))}>🎯 {t('nav.training')}</a>
      <span aria-hidden="true">›</span>
      <span>{themeLabel[n.theme]?.[lang]}</span>
    </nav>
    <div class="page-head">
      <h1>{n.titre[lang]}</h1>
    </div>

    <section class="card training-sheet latex-preview" set:html={md(n.fiche[lang])} />

    {
      hasFicheFigure(n.id) && (
        <figure class="card fiche-figure">
          <figcaption>🎨 {fr ? 'Illustration interactive' : 'Interactive illustration'}</figcaption>
          <div data-fiche={n.id}>
            <noscript>{fr ? 'L’illustration nécessite JavaScript.' : 'The illustration needs JavaScript.'}</noscript>
          </div>
        </figure>
      )
    }

    <section class="training-quiz" id="quiz" aria-live="polite">
      <noscript>{fr ? 'Le quiz nécessite JavaScript.' : 'The quiz needs JavaScript.'}</noscript>
    </section>

    <AccountPanel lang={lang} compact />

    <aside class="training-links">
      {
        chapter && (
          <a href={withBase(localePath(lang, 'courses', `${chapter.id}/`))}>📘 {fr ? chapter.titre_fr : chapter.titre_en}</a>
        )
      }
      {relatedSims.map((s) => <a href={withBase(localePath(lang, 'simulations', `${s.slug}/`))}>🧪 {s.title[lang]}</a>)}
      <a href={withBase(localePath(lang, 'app'))}>📱 {fr ? 'Hors ligne dans l’application' : 'Offline in the app'}</a>
    </aside>

    <ShareButtons lang={lang} title={n.titre[lang]} />
  </div>
  <script type="application/json" id="quiz-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  <script>
    import { startQuiz } from '../scripts/training';
    import { initAccount } from '../scripts/web-account';
    import { initFicheFigure } from '../scripts/fiche';
    startQuiz();
    void initFicheFigure(document.documentElement.lang === 'en' ? 'en' : 'fr');
    initAccount();
  </script>
</Base>
