---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KatexInit from '../components/KatexInit.astro';
import { useT, localePath, type Lang } from '../i18n/ui';
import { withBase, formatDate } from '../lib/site';
import { exercices, sujets, themes, photos, cours } from '../lib/data';
import { sims } from '../lib/sims';
import { partnerLogos, groups, partners } from '../lib/partners';
import { appRelease, mo } from '../lib/app-release';
import { qrSvg } from '../lib/qr';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const appRel = appRelease();
const appUniversal = appRel?.downloads.find((d) => d.abi === 'universal');
const appQr = await qrSvg(new URL(withBase('app/'), Astro.site).href);

const allPosts = (await getCollection('actualites', (e) => e.data.lang === lang)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const posts = allPosts.slice(0, 3);

// — Diapos « événement » (1) et « actualité » (4) —
// Rendu par défaut (sans JavaScript) : diapo 1 = l'actualité marquée enCours, sinon la
// dernière ; diapo 4 = la plus récente des autres. Côté navigateur, chaque session tire
// au hasard deux actualités récentes distinctes (voir initFeed) pour que l'accueil
// paraisse vivant sans répéter le même article dans les deux diapos.
const slugOf = (e: (typeof allPosts)[number]) => e.id.split('/').pop()!.replace(/\.mdx$/, '');

function photosOf(e: (typeof allPosts)[number]): string[] {
  const inBody = [...(e.body ?? '').matchAll(/(?:!\[[^\]]*\]\(|src=")(\/uploads\/[^)\s"]+)/g)].map((m) => m[1]);
  const list = [...e.data.photos, ...(e.data.image ? [e.data.image] : []), ...inBody];
  const unique = [...new Set(list)].slice(0, 5).map((p) => p.replace(/^\//, ''));
  return unique.length ? unique : ['uploads/cloture-camp-2026-01.jpg'];
}

function viewOf(e: (typeof allPosts)[number]) {
  return {
    slug: slugOf(e),
    titre: e.data.titre,
    resume: e.data.resume,
    live: e.data.enCours,
    event: e.data.type === 'evenement',
    dates: e.data.dateFin
      ? `${formatDate(e.data.date, lang)} – ${formatDate(e.data.dateFin, lang)}`
      : formatDate(e.data.date, lang),
    url: withBase(localePath(lang, 'news', `${slugOf(e)}/`)),
    photos: photosOf(e).map((p) => withBase(p)),
  };
}

const featuredPost = allPosts.find((e) => e.data.enCours) ?? allPosts[0];
const newsPost = allPosts.find((e) => e !== featuredPost) ?? featuredPost;
const featured = featuredPost ? viewOf(featuredPost) : null;
const news = newsPost ? viewOf(newsPost) : null;
const feed = {
  labels: {
    live: t('home.camp.badge'),
    featured: t('home.carousel.label'),
    event: t('news.event'),
    article: t('news.article'),
  },
  items: allPosts.slice(0, 6).map(viewOf),
};

// — Simulation à essayer : une simulation tirée au hasard par session (voir initSim) —
const chapterName = (id: string) => {
  const c = cours.find((x) => x.id === id);
  return c ? (lang === 'fr' ? c.titre_fr : c.titre_en) : id;
};
const simCards = sims.map((s) => ({
  slug: s.slug,
  icon: s.icon,
  title: s.title[lang],
  summary: s.summary[lang],
  chapter: chapterName(s.chapter),
  themes: s.themes,
  level: lang === 'fr' ? s.level : ({ collège: 'middle school', lycée: 'high school', prépa: 'undergrad' } as Record<string, string>)[s.level],
  minutes: s.minutes,
  url: withBase(localePath(lang, 'simulations', `${s.slug}/`)),
}));
const simDefault = simCards[Math.floor(Math.random() * simCards.length)];

const currentPath = localePath(lang, 'home');
const altPath = localePath(lang === 'fr' ? 'en' : 'fr', 'home');

---

<Base lang={lang} title={t('site.tagline')} currentPath={currentPath} altPath={altPath}>
  {/* ——— Carrousel « À la une » : défilement automatique ——— */}
  <section
    class="carousel"
    id="carousel"
    aria-roledescription="carousel"
    aria-label={t('home.carousel.label')}
    style="margin-top: -2.5rem;"
    data-lang={lang}
    data-exo-base={withBase(localePath(lang, 'resources'))}
    data-gen-base={withBase(localePath(lang, 'generator'))}
    data-cours-base={withBase(localePath(lang, 'courses'))}
  >
    <div class="carousel-track" id="carousel-track">
      {/* Diapo 1 : événement en cours, piloté par les actualités (enCours: true) */}
      <div class="carousel-slide slide-camp" aria-label="1 / 5">
        <div class="slide-bg-stack" id="hero-bg" aria-hidden="true">
          {
            (featured?.photos ?? []).map((src, i) => (
              <img
                class={`slide-bg${i === 0 ? ' active' : ''}`}
                src={src}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))
          }
        </div>
        <div class="slide-camp-inner">
          <span class="badge badge-live" id="hero-badge">● {featured?.live ? t('home.camp.badge') : t('home.carousel.label')}</span>
          <img
            class="camp-logo"
            src={withBase('logo-comima-texte.png')}
            alt="COMIMa — Club Olympiade Mathématiques et Informatique de Madagascar"
          />
          <h1 id="hero-title">{featured?.titre ?? t('home.hero.title')}</h1>
          <p class="camp-dates" id="hero-dates">{featured?.dates ?? ''}</p>
          <p class="camp-desc" id="hero-desc">{featured?.resume ?? t('home.hero.sub')}</p>
          <div class="camp-partners">
            <span>{t('footer.partner')}</span>
            {
              partnerLogos.map((p) => (
                <a class="partner-logo" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name} title={p.name}>
                  <img src={withBase(p.logo)} alt={p.name} loading="lazy" />
                </a>
              ))
            }
          </div>
          <a class="btn btn-accent" id="hero-cta" href={featured?.url ?? withBase(localePath(lang, 'news'))}>{t('home.camp.cta')}</a>
        </div>
      </div>

      {/* Diapo 2 : l'application Android (téléchargement + QR code) */}
      {
        appRel && (
          <div class="carousel-slide slide-panel slide-app" aria-label="2 / 5">
            <div class="slide-panel-inner slide-app-inner">
              <div class="slide-app-text">
                <p class="slide-kicker">📱 {lang === 'fr' ? 'Nouveau : l’application' : 'New: the app'}</p>
                <h2>{lang === 'fr' ? 'COMIMa dans ta poche, même sans connexion' : 'COMIMa in your pocket, even offline'}</h2>
                <p class="muted">
                  {lang === 'fr'
                    ? 'Quiz corrigés à l’instant, exercices avec solutions, cours et statistiques. Gratuite, pour Android.'
                    : 'Instantly graded quizzes, exercises with solutions, courses and statistics. Free, for Android.'}
                </p>
                <div class="btn-row">
                  <a class="btn btn-primary" href={appUniversal?.url} data-apk-auto>
                    ⬇ {lang === 'fr' ? 'Télécharger' : 'Download'} · {appRel.version}
                  </a>
                  <a class="btn btn-outline btn-sm" href={withBase(localePath(lang, 'app'))}>{lang === 'fr' ? 'En savoir plus' : 'Learn more'}</a>
                </div>
              </div>
              <figure class="slide-app-qr">
                <div class="qr" role="img" aria-label={lang === 'fr' ? 'QR code vers la page de téléchargement' : 'QR code to the download page'} set:html={appQr} />
                <figcaption>{lang === 'fr' ? 'Scanne pour télécharger' : 'Scan to download'}<br /><strong>comima.mg/app</strong></figcaption>
              </figure>
            </div>
          </div>
        )
      }

      {/* Diapo 3 : problème du jour (rendu côté client, change chaque jour) */}
      <div class="carousel-slide slide-panel slide-photo" aria-label="3 / 5">
        <div class="slide-bg-stack" data-photo-pool aria-hidden="true">
          {
            [
              'uploads/epreuves-individuelles-2026-01.jpg',
              'uploads/cloture-camp-2026-03.jpg',
              'uploads/entraide-2026-01.jpg',
            ].map((src, i) => (
              <img class={i === 0 ? 'slide-bg active' : 'slide-bg'} src={withBase(src)} alt="" loading="lazy" />
            ))
          }
        </div>
        <div class="slide-panel-inner">
          <p class="slide-kicker">🎯 {t('home.potd.title')}</p>
          <p class="muted" id="potd-loading">{t('home.potd.loading')}</p>
          <div id="potd-content" hidden>
            <div class="potd-head">
              <h2 id="potd-title"></h2>
              <span class="badges" id="potd-badges"></span>
            </div>
            <div class="latex-preview slide-scroll" id="potd-enonce"></div>
            <div class="btn-row">
              <a class="btn btn-primary btn-sm" id="potd-see" href="#">{t('home.potd.see')}</a>
              <a class="btn btn-outline btn-sm" id="potd-add" href="#">{t('home.potd.add')}</a>
            </div>
          </div>
        </div>
      </div>

      {/* Diapo 3 : principe du jour (rendu côté client, change chaque jour) */}
      <div class="carousel-slide slide-panel slide-principe slide-photo" aria-label="4 / 5">
        <div class="slide-bg-stack" data-photo-pool aria-hidden="true">
          {
            [
              'uploads/entraide-2026-02.jpg',
              'uploads/cloture-camp-2026-05.jpg',
              'uploads/epreuves-individuelles-2026-03.jpg',
            ].map((src, i) => (
              <img class={i === 0 ? 'slide-bg active' : 'slide-bg'} src={withBase(src)} alt="" loading="lazy" />
            ))
          }
        </div>
        <div class="slide-panel-inner">
          <p class="slide-kicker">💡 {t('home.principle.title')}</p>
          <blockquote class="principe-texte" id="principe-texte"></blockquote>
          <p class="muted" id="principe-chapitre"></p>
          <div class="btn-row">
            <a class="btn btn-primary btn-sm" id="principe-cta" href="#">
              {t('home.principle.cta')}
            </a>
          </div>
        </div>
      </div>

      {/* Diapo 4 : dernière actualité */}
      {
        news && (
          <div class="carousel-slide slide-panel slide-photo" aria-label="5 / 5">
            <div class="slide-bg-stack" id="news-bg" aria-hidden="true">
              {news.photos.map((src, i) => (
                <img class={i === 0 ? 'slide-bg active' : 'slide-bg'} src={src} alt="" loading="lazy" />
              ))}
            </div>
            <div class="slide-panel-inner">
              <p class="slide-kicker">📰 {t('home.newsslide.title')}</p>
              <div class="badges">
                <span class={`badge ${news.event ? 'badge-event' : ''}`} id="news-type">
                  {news.event ? t('news.event') : t('news.article')}
                </span>
                <span class="badge" id="news-date">{news.dates}</span>
              </div>
              <h2 id="news-title">{news.titre}</h2>
              <p class="muted slide-scroll" id="news-resume">{news.resume}</p>
              <div class="btn-row">
                <a class="btn btn-primary btn-sm" id="news-cta" href={news.url}>
                  {t('home.newsslide.cta')}
                </a>
              </div>
            </div>
          </div>
        )
      }
    </div>

    <div class="carousel-controls">
      <button class="carousel-arrow" id="carousel-prev" type="button" aria-label={t('carousel.prev')}>
        ‹
      </button>
      <div class="carousel-dots" id="carousel-dots"></div>
      <button class="carousel-arrow" id="carousel-next" type="button" aria-label={t('carousel.next')}>
        ›
      </button>
    </div>
  </section>

  {/* ——— Bande de photos défilante (en continu) ——— */}
  <section
    class="photo-band"
    aria-label={lang === 'fr' ? 'Photos de la vie du club' : 'Club life photos'}
  >
    <div class="photo-band-track" data-photo-band="12">
      {
        /* Repli sans JavaScript : 12 photos tirées au hasard à chaque build, série doublée
           pour la boucle. Le navigateur les remplace par un tirage propre à la session. */
        (() => {
          const pick = [...photos].sort(() => Math.random() - 0.5).slice(0, 12);
          return [...pick, ...pick].map((src) => (
            <img src={withBase(src)} alt="" loading="lazy" />
          ));
        })()
      }
    </div>
  </section>

  <div class="container">
    <div class="stats" aria-label={lang === 'fr' ? 'Chiffres clés' : 'Key figures'}>
      <div class="stat">
        <span class="n" data-count={exercices.length}>{exercices.length}</span>
        <span class="l">{t('home.stats.exercises')}</span>
      </div>
      <div class="stat">
        <span class="n" data-count={sujets.length}>{sujets.length}</span>
        <span class="l">{t('home.stats.papers')}</span>
      </div>
      <div class="stat">
        <span class="n" data-count={themes.length}>{themes.length}</span>
        <span class="l">{t('home.stats.themes')}</span>
      </div>
      <div class="stat">
        <span class="n">100%</span>
        <span class="l">{t('home.stats.free')}</span>
      </div>
    </div>

    <section class="section">
      <h2>{t('home.pillars.title')}</h2>
      <div class="cards">
        <div class="card">
          <h3>♟️ {t('home.pillar1.title')}</h3>
          <p class="muted">{t('home.pillar1.text')}</p>
        </div>
        <div class="card">
          <h3>📚 {t('home.pillar2.title')}</h3>
          <p class="muted">{t('home.pillar2.text')}</p>
        </div>
        <div class="card">
          <h3>🏅 {t('home.pillar3.title')}</h3>
          <p class="muted">{t('home.pillar3.text')}</p>
        </div>
      </div>
      <div class="btn-row" style="margin-top: 1.4rem;">
        <a class="btn btn-primary" href={withBase(localePath(lang, 'resources'))}>
          {t('home.cta.resources')}
        </a>
        <a class="btn btn-outline" href={withBase(localePath(lang, 'generator'))}>
          {t('home.cta.generator')}
        </a>
      </div>
    </section>

    {
      appRel && (
        <section class="section" aria-labelledby="app-promo-title">
          <div class="app-promo">
            <span class="app-promo-icon" aria-hidden="true">📱</span>
            <div>
              <h2 id="app-promo-title">{lang === 'fr' ? 'L’application COMIMa pour Android' : 'The COMIMa app for Android'}</h2>
              <p class="muted">
                {lang === 'fr'
                  ? 'S’entraîner partout, même sans connexion : toutes les notions du cours, des quiz corrigés à l’instant, les exercices avec solutions, vos statistiques.'
                  : 'Practise anywhere, even offline: every topic of the course, instantly graded quizzes, exercises with solutions, your statistics.'}
              </p>
              <div class="btn-row">
                <a class="btn btn-primary" href={appUniversal?.url} data-apk-auto>
                  ⬇ {lang === 'fr' ? 'Télécharger' : 'Download'} · {appRel.version}
                </a>
                <a class="btn btn-outline" href={withBase(localePath(lang, 'app'))}>{lang === 'fr' ? 'En savoir plus' : 'Learn more'}</a>
                <a class="btn btn-outline" href={withBase(localePath(lang, 'training'))}>🎯 {lang === 'fr' ? 'Essayer les quiz en ligne' : 'Try the quizzes online'}</a>
              </div>
              {appRel.downloads.map((d) => (
                <a hidden data-apk={d.abi} data-size={mo(d.bytes, lang === 'fr')} href={d.url}>{d.abi}</a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="section sim-promo" aria-labelledby="sim-promo-title">
      <div class="section-head">
        <h2 id="sim-promo-title">🧪 {lang === 'fr' ? 'À essayer : une simulation' : 'Try this: a simulation'}</h2>
        <a href={withBase(localePath(lang, 'simulations'))}>{lang === 'fr' ? 'Toutes les simulations' : 'All simulations'} →</a>
      </div>
      <div class="sim-promo-card">
        <span class="sim-promo-icon" id="sp-icon" aria-hidden="true">{simDefault.icon}</span>
        <div class="sim-promo-body">
          <p class="sim-promo-chapter" id="sp-chapter">📘 {simDefault.chapter}</p>
          <h3 id="sp-title">{simDefault.title}</h3>
          <p class="muted" id="sp-summary">{simDefault.summary}</p>
          <div class="badges" id="sp-badges">
            {simDefault.themes.map((th) => <span class="badge badge-theme">{th}</span>)}
            <span class="badge">{simDefault.level}</span>
            <span class="badge">⏱ {simDefault.minutes} min</span>
          </div>
          <div class="btn-row">
            <a class="btn btn-primary" id="sp-cta" href={simDefault.url}>{lang === 'fr' ? 'Lancer la simulation →' : 'Start the simulation →'}</a>
            <button class="btn btn-outline" id="sp-other" type="button">🎲 {lang === 'fr' ? 'Une autre' : 'Another one'}</button>
          </div>
        </div>
      </div>
    </section>

    <section class="section network">
      <div class="section-head">
        <h2>{lang === 'fr' ? 'Notre réseau' : 'Our network'}</h2>
        <a href={withBase(localePath(lang, 'partners'))}>{t('footer.partners.all')}</a>
      </div>
      <div class="network-grid">
        {
          groups.map((g) => (
            <a class="network-card" href={withBase(`${localePath(lang, 'partners')}#${g.id}`)}>
              <h3>{lang === 'fr' ? g.title_fr : g.title_en}</h3>
              <div class="network-logos">
                {partners
                  .filter((p) => p.group === g.id)
                  .map((p) => (
                    <img src={withBase(p.logo)} alt={p.name} title={p.name} loading="lazy" decoding="async" />
                  ))}
              </div>
              <p class="muted small">{lang === 'fr' ? g.intro_fr : g.intro_en}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('home.latest.title')}</h2>
        <a href={withBase(localePath(lang, 'news'))}>{t('home.latest.all')} →</a>
      </div>
      <div class="cards">
        {
          posts.map((post) => {
            const slug = post.id.split('/').pop()!.replace(/\.mdx$/, '');
            return (
              <a class="card" href={withBase(localePath(lang, 'news', `${slug}/`))}>
                <div class="badges">
                  <span class={`badge ${post.data.type === 'evenement' ? 'badge-event' : ''}`}>
                    {post.data.type === 'evenement' ? t('news.event') : t('news.article')}
                  </span>
                </div>
                <h3>{post.data.titre}</h3>
                <p class="muted small">{formatDate(post.data.date, lang)}</p>
                <p class="muted">{post.data.resume}</p>
              </a>
            );
          })
        }
      </div>
    </section>
  </div>

  <script type="application/json" id="home-sims" set:html={JSON.stringify(simCards).replace(/</g, '\\u003c')} />
  <script type="application/json" id="home-feed" set:html={JSON.stringify(feed).replace(/</g, '\\u003c')} />
  <script>
    import { latexToHtml } from '../lib/latex';
    import { principes } from '../lib/principes';

    const root = document.getElementById('carousel');
    const lang = (root?.dataset.lang ?? 'fr') as 'fr' | 'en';
    const day = Math.floor(Date.now() / 86400000);

    // — Problème du jour (change chaque jour, sans redéploiement) —
    async function initPotd() {
      if (!root) return;
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      try {
        const res = await fetch(`${base}/data/exercices-index.json`);
        const { exercices } = await res.json();
        if (!exercices?.length) return;
        const exo = exercices[day % exercices.length];
        const titre = lang === 'fr' ? exo.titre_fr : exo.titre_en;

        document.getElementById('potd-title')!.textContent = titre;
        const badges = document.getElementById('potd-badges')!;
        for (const th of exo.theme) {
          const b = document.createElement('span');
          b.className = 'badge badge-theme';
          b.textContent = th;
          badges.append(b);
        }
        const stars = document.createElement('span');
        stars.className = 'badge';
        stars.textContent = '★'.repeat(exo.difficulte);
        badges.append(stars);

        document.getElementById('potd-enonce')!.innerHTML = latexToHtml(exo.enonceTex);
        (document.getElementById('potd-see') as HTMLAnchorElement).href =
          `${root.dataset.exoBase}${exo.id}/`;
        (document.getElementById('potd-add') as HTMLAnchorElement).href =
          `${root.dataset.genBase}?add=${exo.id}`;

        document.getElementById('potd-loading')!.hidden = true;
        document.getElementById('potd-content')!.hidden = false;
        document.dispatchEvent(new CustomEvent('comima:render-math'));
      } catch {
        // Index indisponible (dev local sans build) : message de chargement conservé.
      }
    }

    // — Principe du jour —
    function initPrincipe() {
      if (!root) return;
      const p = principes[day % principes.length];
      const texte = document.getElementById('principe-texte');
      const chap = document.getElementById('principe-chapitre');
      const cta = document.getElementById('principe-cta') as HTMLAnchorElement | null;
      if (!texte || !chap || !cta) return;
      texte.innerHTML = latexToHtml(lang === 'fr' ? p.fr : p.en);
      texte.classList.add('latex-preview');
      chap.textContent = lang === 'fr' ? p.chapitreFr : p.chapitreEn;
      cta.href = root.dataset.coursBase!;
      document.dispatchEvent(new CustomEvent('comima:render-math'));
    }

    // — Carrousel : défilement automatique, points, flèches —
    function initCarousel() {
      const track = document.getElementById('carousel-track');
      const dotsBox = document.getElementById('carousel-dots');
      if (!root || !track || !dotsBox) return;
      const slides = [...track.children] as HTMLElement[];
      const n = slides.length;
      if (n < 2) return;

      let index = 0;
      let timer: number | undefined;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const gotoLabel = root.getAttribute('aria-label') ?? '';

      const dots = slides.map((_, i) => {
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'carousel-dot';
        d.setAttribute('aria-label', `${gotoLabel} ${i + 1}`);
        d.addEventListener('click', () => {
          go(i);
          restart();
        });
        dotsBox.append(d);
        return d;
      });

      function go(i: number) {
        index = (i + n) % n;
        track!.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('active', j === index));
      }

      function restart() {
        if (reduced) return;
        clearInterval(timer);
        timer = window.setInterval(() => go(index + 1), 7000);
      }

      document.getElementById('carousel-prev')!.addEventListener('click', () => {
        go(index - 1);
        restart();
      });
      document.getElementById('carousel-next')!.addEventListener('click', () => {
        go(index + 1);
        restart();
      });

      // Pause au survol / au clavier, reprise en sortie.
      root.addEventListener('mouseenter', () => clearInterval(timer));
      root.addEventListener('mouseleave', restart);
      root.addEventListener('focusin', () => clearInterval(timer));
      root.addEventListener('focusout', restart);

      go(0);
      restart();
    }

    // — Diapos 1 et 4 : deux actualités récentes tirées au hasard par session —
    type FeedItem = {
      slug: string; titre: string; resume: string; live: boolean; event: boolean;
      dates: string; url: string; photos: string[];
    };
    function initFeed() {
      const raw = document.getElementById('home-feed')?.textContent;
      if (!raw) return;
      const { labels, items } = JSON.parse(raw) as {
        labels: { live: string; featured: string; event: string; article: string };
        items: FeedItem[];
      };
      if (items.length < 2) return;

      // Paire de la session (stable d'une page à l'autre, différente à la session suivante).
      let pair: string[] | null = null;
      try {
        pair = JSON.parse(sessionStorage.getItem('comima-home-feed') ?? 'null');
      } catch {
        pair = null;
      }
      const valid =
        pair && pair[0] !== pair[1] && items.some((i) => i.slug === pair![0]) && items.some((i) => i.slug === pair![1]);
      if (!valid) {
        const a = Math.floor(Math.random() * items.length);
        let b = Math.floor(Math.random() * (items.length - 1));
        if (b >= a) b += 1;
        pair = [items[a].slug, items[b].slug];
        try {
          sessionStorage.setItem('comima-home-feed', JSON.stringify(pair));
        } catch {
          /* stockage indisponible */
        }
      }
      const hero = items.find((i) => i.slug === pair![0])!;
      const other = items.find((i) => i.slug === pair![1])!;
      const text = (id: string, value: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      };
      const stack = (id: string, photos: string[]) => {
        const box = document.getElementById(id);
        if (!box) return;
        box.replaceChildren(
          ...photos.map((src, i) => {
            const img = document.createElement('img');
            img.className = i === 0 ? 'slide-bg active' : 'slide-bg';
            img.src = src;
            img.alt = '';
            img.loading = i === 0 ? 'eager' : 'lazy';
            return img;
          }),
        );
      };

      text('hero-badge', `● ${hero.live ? labels.live : labels.featured}`);
      text('hero-title', hero.titre);
      text('hero-dates', hero.dates);
      text('hero-desc', hero.resume);
      (document.getElementById('hero-cta') as HTMLAnchorElement | null)?.setAttribute('href', hero.url);
      stack('hero-bg', hero.photos);

      const type = document.getElementById('news-type');
      if (type) {
        type.textContent = other.event ? labels.event : labels.article;
        type.classList.toggle('badge-event', other.event);
      }
      text('news-date', other.dates);
      text('news-title', other.titre);
      text('news-resume', other.resume);
      (document.getElementById('news-cta') as HTMLAnchorElement | null)?.setAttribute('href', other.url);
      stack('news-bg', other.photos);
    }

    // — Simulation à essayer : tirage par session, bouton « Une autre » —
    function initSimPromo() {
      const raw = document.getElementById('home-sims')?.textContent;
      if (!raw) return;
      type Card = { slug: string; icon: string; title: string; summary: string; chapter: string; themes: string[]; level: string; minutes: number; url: string };
      const cards = JSON.parse(raw) as Card[];
      if (!cards.length) return;
      let slug: string | null = null;
      try {
        slug = sessionStorage.getItem('comima-home-sim');
      } catch {
        slug = null;
      }
      let cur = cards.find((c) => c.slug === slug) ?? cards[Math.floor(Math.random() * cards.length)];
      const show = (c: Card) => {
        cur = c;
        try {
          sessionStorage.setItem('comima-home-sim', c.slug);
        } catch {
          /* stockage indisponible */
        }
        const set = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };
        set('sp-icon', c.icon);
        set('sp-chapter', `📘 ${c.chapter}`);
        set('sp-title', c.title);
        set('sp-summary', c.summary);
        (document.getElementById('sp-cta') as HTMLAnchorElement | null)?.setAttribute('href', c.url);
        const badges = document.getElementById('sp-badges');
        if (badges) {
          badges.replaceChildren(
            ...c.themes.map((th) => Object.assign(document.createElement('span'), { className: 'badge badge-theme', textContent: th })),
            Object.assign(document.createElement('span'), { className: 'badge', textContent: c.level }),
            Object.assign(document.createElement('span'), { className: 'badge', textContent: `⏱ ${c.minutes} min` }),
          );
        }
      };
      show(cur);
      document.getElementById('sp-other')?.addEventListener('click', () => {
        const others = cards.filter((c) => c.slug !== cur.slug);
        show(others[Math.floor(Math.random() * others.length)]);
      });
    }

    initFeed();
    initSimPromo();
    initPotd();
    initPrincipe();
    initCarousel();
    // Fond des diapos (héros + panneaux) : rotation en fondu de plusieurs photos.
    import('../scripts/photo-rotate').then(({ rotatePhotoStacks }) => {
      rotatePhotoStacks(root ?? document, '.slide-bg-stack', 5000);
    });

    // — Compteurs animés des chiffres clés —
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLElement>('.stat .n[data-count]').forEach((el) => {
        const target = Number(el.dataset.count);
        if (!target) return;
        const start = performance.now();
        const dur = 1200;
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }
  </script>
  <KatexInit />
  <script>
    import { initAppDownload } from '../scripts/app-download';
    initAppDownload();
  </script>
</Base>
