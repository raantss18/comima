---
import { useT, localePath, type Lang } from '../i18n/ui';
import ShareButtons from './ShareButtons.astro';
import { withBase } from '../lib/site';
import { partnerLogos } from '../lib/partners';
import { centres } from '../lib/centres';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const siteUrl = new URL(withBase(`${lang}/`), Astro.site).href;
---

<footer class="site-footer">
  <div class="container">
    <section class="partners-strip" aria-label={t('footer.partners')}>
      <h4>{t('footer.partners')}</h4>
      <ul>
        {
          partnerLogos.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name} title={p.name}>
                <img src={withBase(p.logo)} alt={p.name} loading="lazy" decoding="async" />
              </a>
            </li>
          ))
        }
      </ul>
      <a class="partners-all" href={withBase(localePath(lang, 'partners'))}>{t('footer.partners.all')}</a>
    </section>
    <div class="footer-grid">
      <div>
        <a class="brand" href={withBase(`${lang}/`)}>
          <img src={withBase('logo-rond.png')} alt="" width="48" height="48" />
          <span><span class="brand-primary">COMI</span><span class="brand-accent">Ma</span></span>
        </a>
        <p class="muted" style="max-width: 34rem; margin-top: 0.8rem;">
          {t('site.fullname')} — {centres.map((c) => c.name).join(' · ')} (Madagascar).
        </p>
      </div>
      <nav aria-label={t('footer.links')}>
        <h4>{t('footer.links')}</h4>
        <ul>
          <li><a href={withBase(localePath(lang, 'news'))}>{t('nav.news')}</a></li>
          <li><a href={withBase(localePath(lang, 'courses'))}>{t('nav.courses')}</a></li>
          <li><a href={withBase(localePath(lang, 'simulations'))}>🧪 {t('nav.simulations')}</a></li>
          <li><a href={withBase(localePath(lang, 'resources'))}>{t('nav.resources')}</a></li>
          <li><a href={withBase(localePath(lang, 'papers'))}>{t('nav.papers')}</a></li>
          <li><a href={withBase(localePath(lang, 'generator'))}>{t('nav.generator')}</a></li>
          <li><a href={withBase(localePath(lang, 'training'))}>🎯 {t('nav.training')}</a></li>
          <li><a href={withBase(localePath(lang, 'app'))}>📱 {t('nav.app')}</a></li>
        </ul>
      </nav>
      <div>
        <h4>COMIMa</h4>
        <ul>
          <li><a href={withBase(localePath(lang, 'about'))}>{t('nav.about')}</a></li>
          <li><a href={withBase(localePath(lang, 'partners'))}>{t('nav.partners')}</a></li>
          <li><a href={withBase(localePath(lang, 'contact'))}>{t('nav.contact')}</a></li>
          <li><a href="https://www.facebook.com/share/1UrqDjwXJ8/" rel="noopener">Facebook</a></li>
          <li><a href={withBase(localePath(lang, 'legal'))}>{t('footer.legal')}</a></li>
          <li><a href={withBase('admin/')} rel="nofollow">{t('footer.admin')}</a></li>
        </ul>
      </div>
    </div>
    <ShareButtons lang={lang} title={t('site.tagline')} url={siteUrl} heading={t('share.site')} />
    <div class="footer-bottom">
      <span>© {year} COMIMa. {t('footer.rights')}</span>
      <span>
        Astro · KaTeX · LaTeX · GitHub Pages
      </span>
    </div>
  </div>
</footer>
